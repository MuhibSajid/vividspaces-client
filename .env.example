# Public base URL of the VividSpaces API (required for any deployed build).
# Defaults to https://vividspaces-server.vercel.app in production.
# Inlined at build time — redeploy after changing it.
NEXT_PUBLIC_API_URL=https://vividspaces-server.vercel.app

# better-auth (server)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# MongoDB Atlas connection string (server)
MONGODB_CLIENT_URL=
